CAPTCHA_PROVIDER=recaptcha
RECAPTCHA_SITE_KEY=6Ldf_your_google_recaptcha_v3_site_key_here
RECAPTCHA_SECRET_KEY=6Ldf_your_google_recaptcha_v3_secret_key_here

# Supabase Database & Security Configuration
VITE_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_server_side_only
